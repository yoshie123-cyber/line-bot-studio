# ===== 必須 =====
OPENAI_API_KEY=
# Twilio Console のトップ（Account Info）にある Auth Token。Webhookの署名検証に使います
TWILIO_AUTH_TOKEN=
# このサーバーの公開URL（末尾スラッシュなし）。例: https://ai-phone.onrender.com
PUBLIC_BASE_URL=

# ===== 担当者への転送 =====
# 転送先の電話番号（E.164形式）。空なら転送しません。
# Trialアカウントでは「Verified Caller IDs」に登録した番号にしか転送できません。
TRANSFER_PHONE_NUMBER=

# ===== 会話の内容 =====
COMPANY_NAME=
WELCOME_GREETING=お電話ありがとうございます。AI受付です。本日はどのようなお問い合わせでしょうか？
# 営業時間・対応できる内容など（AIの回答の根拠になります）
BUSINESS_INFO=
OPENAI_MODEL=gpt-4.1-mini

# ===== 音声（空ならTwilioの日本語デフォルト） =====
RELAY_LANGUAGE=ja-JP
# Google / Amazon / ElevenLabs
TTS_PROVIDER=
TTS_VOICE=
# Google / Deepgram
STT_PROVIDER=
STT_SPEECH_MODEL=
# 転送アナウンスの声（TwiML <Say>）
SAY_VOICE=Polly.Kazuha-Neural
